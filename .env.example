# Guardar este archivo como ".env" (UTF-8). No subir .env al repositorio.
# Ruta alternativa: definir DOTENV_PATH=C:\ruta\a\.env

# ── Base de datos (app) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=talentflow_user
DB_PASSWORD=talentflow123
DB_NAME=talentflow_db

# ── PostgreSQL admin (solo setup_db.py) ─────────────────────────
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_ADMIN_DB=postgres

# ── Flask ───────────────────────────────────────────────────────
SECRET_KEY=tu_clave_secreta_muy_larga_y_aleatoria
# development | production
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_PORT=5000
# Para que otros PCs en la red abran http://TU_IP:5000 — usar 0.0.0.0 (solo desarrollo).
FLASK_RUN_HOST=0.0.0.0

# ── Subidas ─────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads/candidatos
MAX_CONTENT_LENGTH_MB=10

# ── Email (Flask-Mail; opcional) ────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Scheduler (opcional) ───────────────────────────────────────
ENABLE_SCHEDULER=False

# ── IA (opcional): botón «Análisis IA» en detalle de proceso ─────
# Clave en https://console.anthropic.com/ → API Keys. Sin esto verás aviso al usar el botón.
ANTHROPIC_API_KEY=
